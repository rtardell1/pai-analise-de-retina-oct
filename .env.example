# Configuração do pipeline PAI — análise de retina (OCT + RD).
# Copie para `.env` e ajuste. O `.env` NÃO é versionado (ver .gitignore).

# --- Checkpoints (repo_id do Hugging Face ou caminho local de um .pth) ---
# Carregados via timm.create_model("hf_hub:<repo_id>"). Não são gated.
MODEL_OCT_CHECKPOINT=bitfount/RETFound_MAE_OCT_CNV_DME_DRU
MODEL_FUNDUS_CHECKPOINT=bitfount/RETFound_DR_IDRID

# --- Diretórios ---
DATA_DIR=./data
OUTPUT_DIR=./outputs

# --- Execução ---
# DEVICE_PREFERENCE: auto | cuda | mps | cpu  (auto: CUDA -> MPS -> CPU)
DEVICE_PREFERENCE=auto
SEED=42

# --- Limiares de confiança (seção 6 do enunciado) ---
CONF_PMAX_HIGH=0.85
CONF_MARGIN_HIGH=0.30
CONF_PMAX_LOW=0.60
CONF_ENTROPY_HIGH=0.75

# --- Guarda de modalidade (heurística de saturação HSV, [0,1]) ---
# Saturação média <= limiar => estimado OCT; acima => estimado FUNDUS.
MODALITY_SATURATION_THRESHOLD=0.12
